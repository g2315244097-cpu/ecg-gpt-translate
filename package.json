{
  "name": "@ppppeter/ecg-gpt-translate",
  "version": "1.0.0",
  "description": "Upload an ECG image, fetch the ECG-GPT interpretation, translate it into Chinese, and show a severity-sorted Chinese report.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ecg",
    "ecg-gpt",
    "translation",
    "chinese"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
